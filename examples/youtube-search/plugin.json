{
  "$schema": "../../schema/plugin.schema.json",
  "schemaVersion": 1,
  "runtime": "declarative-feed",
  "id": "com.youtube.search",
  "name": "YouTube 搜索",
  "version": "1.4.0",
  "description": "按关键词搜索 YouTube 博主，并从结果列表直接订阅频道。使用公开搜索页，不需要 API Key 或登录。",
  "homepage": "https://www.youtube.com/",
  "publisher": {
    "name": "Merge examples",
    "url": "https://www.youtube.com/"
  },
  "iconSystemName": "magnifyingglass",
  "permissions": {
    "domains": ["www.youtube.com", "m.youtube.com"],
    "maximumResponseBytes": 5242880
  },
  "input": {
    "type": "query",
    "title": "搜索关键词",
    "placeholder": "例如 SwiftUI 教程",
    "encoding": "urlQuery"
  },
  "request": {
    "url": "https://www.youtube.com/results?search_query={{input}}&sp=EgIQAg%3D%3D",
    "method": "GET"
  },
  "subscription": {
    "mode": "feedFromExternalID",
    "feedURL": "https://www.youtube.com/feeds/videos.xml?channel_id={{externalID}}",
    "targetKind": "channel"
  },
  "response": {
    "format": "htmlJSON",
    "embeddedJSON": {
      "marker": "var ytInitialData = ",
      "itemsPath": "contents.twoColumnSearchResultsRenderer.primaryContents.sectionListRenderer.contents.0.itemSectionRenderer.contents",
      "itemsPaths": [
        "contents.twoColumnSearchResultsRenderer.primaryContents.sectionListRenderer.contents.0.itemSectionRenderer.contents",
        "contents.sectionListRenderer.contents.0.itemSectionRenderer.contents"
      ],
      "itemObjectPaths": ["channelRenderer", "compactChannelRenderer"]
    },
    "source": {
      "externalID": { "constant": "youtube-search" },
      "title": { "constant": "YouTube 搜索结果" },
      "homeURL": { "constant": "https://www.youtube.com/" }
    },
    "items": {
      "jsonPath": "items",
      "externalID": { "jsonPath": "channelId", "required": true },
      "url": { "jsonPath": "navigationEndpoint.commandMetadata.webCommandMetadata.url", "required": true },
      "title": {
        "jsonPaths": ["title.simpleText", "title.runs.0.text"],
        "required": true
      },
      "author": { "jsonPaths": ["subscriberCountText.simpleText", "subscriberCountText.runs.0.text"] },
      "summary": { "jsonPaths": ["descriptionSnippet.runs.0.text", "descriptionSnippet.simpleText"] },
      "images": { "jsonPath": "thumbnail.thumbnails.0.url" }
    }
  }
}
